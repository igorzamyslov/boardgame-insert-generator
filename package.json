{
  "name": "insert-generator",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vitest run && tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/smoke-dist.mjs dist",
    "build:deploy": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/smoke-dist.mjs dist",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p worker/feedback",
    "lint": "eslint . && npm run lint:css && npm run lint:html",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run build",
    "seeds": "node scripts/design/make-seeds.mjs",
    "shots": "node scripts/design/shots.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "rollup-plugin-license": "^3.7.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "!(*.dc).html": [
      "html-validate",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}

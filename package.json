{
  "name": "insert-generator",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vitest run && tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/smoke-dist.mjs dist",
    "build:deploy": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/smoke-dist.mjs dist",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && npm run lint:css && npm run lint:html",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run build",
    "seeds": "node scripts/design/make-seeds.mjs",
    "shots": "node scripts/design/shots.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "preact": "^11.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.7.0",
    "html-validate": "^11.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.0.8",
    "playwright": "^1.64.1",
    "prettier": "^3.9.5",
    "rollup-plugin-license": "^3.7.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "!(*.dc).html": [
      "html-validate",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
